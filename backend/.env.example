# backend/.env.example — 값은 자리표시자. 실제 값은 backend/.env 에만 (git 제외, CLAUDE.md)
NODE_ENV=development
PORT=9522
APP_BASE_URL=http://127.0.0.1:9502

# 팀 DB (MariaDB B, 12.0.2) — 실제 값은 팀에서 따로 전달받아 backend/.env 에만
DB_HOST=__TEAM_DB_HOST__
DB_PORT=23306
DB_USER=__TEAM_DB_USER__
DB_PASSWORD=__FILL_ME__
DB_NAME=__TEAM_DB_NAME__

# 테스트 DB (로컬 — npm run devdb:start 로 띄우는 12.0 인스턴스)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=23610
TEST_DB_USER=__LOCAL_TEST_USER__
TEST_DB_PASSWORD=__LOCAL_TEST_PASSWORD__
TEST_DB_NAME=crd_test

# 세션·쿠키
SESSION_SECRET=__random_64_chars__

# 소셜 로그인 (FR-043 — 카카오·네이버만, 비밀번호 저장 없음)
KAKAO_CLIENT_ID=__kakao_rest_api_key__
KAKAO_CLIENT_SECRET=__kakao_client_secret__
NAVER_CLIENT_ID=__naver_client_id__
NAVER_CLIENT_SECRET=__naver_client_secret__
OAUTH_REDIRECT_BASE=http://127.0.0.1:9502
# 개발용 로그인 제공자 — production 에서는 켜지지 않는다
AUTH_DEV_PROVIDER=false

# 원본 파일 임시 보관 (DB 밖, 24시간 내 삭제 — research R-12)
RAW_STORAGE_DIR=./var/raw
RAW_FILE_KEY=__64_hex_chars_32_bytes__

# 모델 서버 — 개발·CI 는 스텁(tools/model-api-stub), 실모델은 model-server 게이트웨이(같은 포트)
MODEL_API_BASE_URL=http://127.0.0.1:9542
MODEL_API_KEY=__model_api_key__
# M3·M4(LLM) 호출 타임아웃 — 공유 Ollama 대기열·모델 적재 시간을 포함하므로 300초 (model-serving §0)
MODEL_LLM_TIMEOUT_SEC=300

# 정책 기본값 (policy_constant 가 unknown 일 때만 사용 — research R-15)
DETECT_THRESHOLD_M1=0.5
DETECT_THRESHOLD_M2=0.5
ANON_SESSION_TTL_HOURS=24
ANALYSIS_CONCURRENCY=2
# 공유 Ollama 는 동시 1건 — model-serving §0 (전용 인스턴스 시 4)
JUDGE_CONCURRENCY=1

# 근거 수집 원천 키 (P0 — 선택)
LAW_API_OC=__law_open_api_oc__
DATA_PORTAL_KEY=__data_portal_key__
# 정기 수집 cron(선택, 예: 0 6 * * *) — 비우면 운영자가 S0 에서 수동 시작
KNOWLEDGE_CRON=
# 국가법령정보센터 DRF(법령·공정위 결정문 공용 OC), 공공데이터포털 표준약관 서비스 주소, 한국소비자원 참고 자료 키·주소
LAW_API_BASE_URL=https://www.law.go.kr/DRF
DATA_PORTAL_STD_TERMS_URL=
KCA_API_KEY=__kca_api_key__
KCA_API_URL=
KNOWLEDGE_COLLECT_TIMEOUT_SEC=30
# 수집·전처리 결과 임시 보관(공개 법령·사례 텍스트만, 승인 전까지)
KNOWLEDGE_STAGING_DIR=./var/knowledge
