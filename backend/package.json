{
  "name": "crd-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:reset": "tsx scripts/migrate.ts --reset-test",
    "db:ddl-tests": "tsx scripts/run-ddl-tests.ts",
    "db:check-ddl-copy": "tsx scripts/check-ddl-copy.ts",
    "seed:knowledge": "tsx scripts/seed-knowledge.ts",
    "ops:raw-retention": "tsx scripts/ops-raw-retention.ts",
    "ops:gates": "tsx scripts/ops-gates.ts",
    "admin:grant-role": "tsx scripts/admin-grant-role.ts",
    "admin:create-account": "tsx scripts/admin-create-account.ts",
    "audit:assertions": "tsx scripts/audit-assertions.ts",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "samples:build": "tsx scripts/build-sample-terms.ts",
    "devdb:start": "sh scripts/devdb.sh start",
    "devdb:stop": "sh scripts/devdb.sh stop",
    "knowledge:bootstrap": "tsx scripts/bootstrap-knowledge.ts",
    "knowledge:embed": "tsx scripts/embed-evidence.ts",
    "knowledge:eval-retrieval": "tsx scripts/eval-retrieval.ts",
    "knowledge:search-batch": "tsx scripts/search-evidence-batch.ts",
    "abstention:calibrate": "tsx scripts/calibrate-abstention.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^4.5.7",
    "helmet": "^8.3.0",
    "hwp.js": "^0.0.3",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^1.4.4",
    "mysql2": "^3.24.4",
    "node-cron": "^3.0.3",
    "p-limit": "^6.2.0",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "docx": "^9.8.0",
    "pdfkit": "^0.15.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
