<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  게이트웨이 전용 사용자 LaunchAgent. scripts/install_launchd.sh 가 __DIR__·__HOME__·__PORT__ 를 채워
  가상환경(.venv)의 uvicorn 을 직접 실행한다(uv run 은 동기화로 torch extra 를 지울 수 있어 쓰지 않는다).
  ~/Library/LaunchAgents/ 에 복사한다.
  비밀값(MODEL_API_KEY 등)은 여기 쓰지 않는다 — app/config.py 가 model-server/.env 를 읽는다.
  Ollama plist 는 없다: 공유 Ollama(127.0.0.1:11434)를 쓰며 계정에서 ollama serve 를 띄우지 않는다.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.crd.model-server</string>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DIR__/.venv/bin/uvicorn</string><string>app.main:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>__PORT__</string>
    <string>--workers</string><string>1</string>
    <string>--no-access-log</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/crd-model-server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/crd-model-server.log</string>
</dict>
</plist>
