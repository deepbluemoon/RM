{
  "$comment": "M3 /api/chat format 템플릿. app/llm.py 가 요청마다 explanation.items.properties.evidence_ids.items.enum 을 그 요청의 근거 ID 로 채운다(근거가 없으면 explanation maxItems 0).",
  "type": "object",
  "required": ["risk_class", "risk_type", "risk_level", "confidence", "explanation"],
  "properties": {
    "risk_class": { "type": "string", "enum": ["normal", "dispute", "unfair", "illegal"] },
    "risk_type": {
      "type": ["string", "null"],
      "enum": ["rights_limit", "liability_avoid", "refund_cancel_limit", "unilateral_change", "excessive_penalty", "vague", "other", null]
    },
    "risk_level": { "type": ["string", "null"], "enum": ["high", "mid", "low", null] },
    "confidence": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
    "explanation": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["claim", "evidence_ids"],
        "properties": {
          "claim": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": [] } }
        }
      }
    }
  }
}
