# M4 요약 — Qwen/Qwen3-1.7B 공식 원본 bf16 (양자화 없음)
# 등록: scripts/provision_models.sh → ollama create pioneer2-crd-m4:v1
# num_ctx: 계획(§4)의 32768 대신 공유 서버 한도 8192(§0) — 긴 문서는 app/summarize_input.py 절단 규칙 적용
FROM ../var/gguf/m4-bf16.gguf
PARAMETER temperature 0
PARAMETER top_k 1
PARAMETER seed 0
PARAMETER num_ctx 8192
PARAMETER num_predict 600
