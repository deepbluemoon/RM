# model-server 환경변수 예시 — 복사해 .env 로 쓴다(.env 는 git 에 올리지 않는다)
MODEL_API_KEY=<백엔드 MODEL_API_KEY 와 같은 값>

# M3(판정)·M4(요약) 공급자 — 기본 ollama. 로컬에 qwen3:4b 를 못 띄우면 gemini/vertex 로 바꾼다.
# 어느 쪽이든 임베딩(bge-m3)·M1·M2 는 그대로 아래 Ollama 설정을 쓴다. 속도는 lite(gemini-3.5-flash-lite ≈1s) 권장.
#
# (A) gemini — Google AI Studio, API 키. 무료 티어(분당 15·일 1,500) 또는 선불 크레딧.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=<Google AI Studio 에서 발급한 키>
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# (B) vertex — Google Cloud(Vertex AI), ADC 인증 + GCP 크레딧 차감. 무료 티어 한도 없음(호출 많은 팀용).
#     사전: gcloud auth application-default login  +  해당 프로젝트에 Vertex AI API 사용 설정
#     현재 세대 Gemini 는 location=global 에만 있다(us-central1 등 리전엔 404).
#     vertex 는 responseJsonSchema 로 출력 구조를 강제해도 빠르다 → lite 로 ≈1초 + 설명 구조 보장(실측).
# LLM_PROVIDER=vertex
# VERTEX_PROJECT=<GCP 프로젝트 ID>
# VERTEX_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_URL=http://127.0.0.1:11434
# 채팅 모델은 서비스당 1개(가이드 1.7-4) — M3·M4 에 같은 이름. 기본 = 공용 A등급(설치돼 있어 추가 작업 없음)
OLLAMA_M3_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_M4_MODEL=qwen3:4b-instruct-2507-q4_K_M
# 관리자와 협의해 bf16 커스텀을 등록했다면(provision_models.sh) 둘 다 그 이름으로: pioneer2-crd-m3:v1
# 개발 전용: 주 모델이 설치되지 않았을 때만 쓴다. model_version 이 ollama:<이름> 으로 바뀌어 판정 캐시가 분리된다
# OLLAMA_M3_FALLBACK=gemma3:4b
# OLLAMA_M4_FALLBACK=gemma3:4b
# 기동 시 1회 미리 올리기(기본 true). 테스트·배치에서 끄려면 false
# OLLAMA_WARMUP_ON_START=true
# MODEL_ROOT=/Users/<계정>/project2610/model-server/var/models
# ASSERTION_TERMS_PATH=../shared/assertion-terms.json
