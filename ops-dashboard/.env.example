# 현재 프로젝트 컨테이너만 감시하려면 image-or-name 범위를 사용한다.
OPS_CONTAINER_SCOPE=image-or-name
OPS_IMAGE_PREFIXES=moonsangjin/tamji,mariadb
OPS_NAME_PREFIXES=rm-contract-risk-backend,rm-contract-risk-frontend,rm-contract-risk-model-server,rm-contract-risk-ollama,rm-contract-risk-mariadb

# 자원·로그 수집
OPS_DASHBOARD_PORT=9760
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_POLL_MS=5000
OPS_RESOURCE_THRESHOLD=80
OPS_HTTP_STATUS_LOG_TAIL=200
OPS_HTTP_STATUS_ALERT_DURATION_MS=30000
OPS_DEPLOYMENT_VERSION=

# 패키지 보안·릴리즈 정보 (GitHub Releases 요청 제한 완화용, 선택)
OPS_PACKAGE_REFRESH_MS=21600000
GITHUB_TOKEN=

# OPS-CPU-80-001 / OPS-MEM-80-001 대응: 무상태 서비스만 지정한다.
OPS_COMPOSE_FILE=/srv/tamji/compose.yml
OPS_SCALE_SERVICE=
OPS_SCALE_TARGET=2
OPS_SCALE_MAX=5
OPS_SCALE_WAIT_SECONDS=30
OPS_SCALE_ALLOWED_SERVICES=
# 현재 RM의 backend·frontend·model-server·DB는 실행 중인 작업/큐/고정 포트가 있어 기본 차단
OPS_SCALE_BLOCKED_SERVICES=backend,frontend,model-server,mariadb,mysql,database,db,backend-init,backend-embed
OPS_DIAGNOSTICS_DIR=./.ops-data/reports
OPS_ACTION_AUDIT_FILE=./.ops-data/action-audit.jsonl
