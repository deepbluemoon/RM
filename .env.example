# compose.yaml 용 환경 변수 예시 — 복사해 .env 로 쓴다(.env 는 git 제외. 실제 값은 저장소·이슈·채팅에 올리지 않는다)
#   cp .env.example .env
# 무작위 값 만들기: openssl rand -hex 32   (또는 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ── 이미지 (Docker Hub moonsangjin/tamji — fe·be·ms 약어 태그, docs/docker-image-policy.md)
TAMJI_IMAGE=moonsangjin/tamji
TAMJI_VERSION=0.1.0

# ── 화면 주소·공개 범위
FRONTEND_PORT=8080
# 127.0.0.1 = 이 PC 에서만. 같은 네트워크의 다른 기기에서 접속하려면 0.0.0.0
FRONTEND_BIND=127.0.0.1
APP_BASE_URL=http://localhost:8080

# ── DB (MariaDB 컨테이너)
DB_NAME=crd
DB_USER=crd
DB_PASSWORD=__FILL_ME__
DB_ROOT_PASSWORD=__FILL_ME__
# DB 데이터 위치 — 비우면 이름 있는 볼륨(db-data, 권장). 폴더에 두려면 경로(예: ./data/mariadb)
DB_DATA=

# ── 백엔드 비밀값
SESSION_SECRET=__64_hex_chars__
RAW_FILE_KEY=__64_hex_chars__
# 백엔드·모델 서버가 같은 값을 쓴다
MODEL_API_KEY=__FILL_ME__
# 쿠키 secure — 비우면 off(PC·HTTP). HTTPS 앞단이 있는 운영 서버는 auto
COOKIE_SECURE=

# ── 모델 서버 LLM(M3 판정·M4 요약) — docs/gemini-vertex-setup.md
LLM_PROVIDER=vertex
VERTEX_PROJECT=__gcp_project_id__
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# Vertex 인증 파일 경로(이 PC 의 파일. 컨테이너에 읽기 전용으로 연결된다)
#   개인 ADC(gcloud auth application-default login) 파일 위치
#     Windows: C:/Users/<계정>/AppData/Roaming/gcloud/application_default_credentials.json
#     Mac·Linux: ~/.config/gcloud/application_default_credentials.json  (~ 대신 절대 경로로)
#   또는 서비스 계정 키 파일 경로
GCP_CREDENTIALS_FILE=__path_to_credentials_json__
# LLM_PROVIDER=gemini(AI Studio)일 때만
GEMINI_API_KEY=

# ── 근거 정기 수집(선택) — 비우면 운영자가 S0 에서 수동 수집. 반영은 S0 승인 후
# 권장: 매일 06:00(한국 시간). 법령 API 의 일자별 개정 이력은 전일 기준(D+1)으로 제공된다
KNOWLEDGE_CRON=
LAW_API_OC=
DATA_PORTAL_KEY=
DATA_PORTAL_STD_TERMS_URL=
KCA_API_KEY=
KCA_API_URL=

# ── 소셜 로그인(선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 자원 제한(선택) — 비우면 compose.yaml 기본값(최대 사용량 상한). 운영 서버 사양에 맞출 때만
# LIMIT_MARIADB_CPUS=1.0
# LIMIT_MARIADB_MEMORY=1g
# LIMIT_MODEL_SERVER_CPUS=2.0
# LIMIT_MODEL_SERVER_MEMORY=2g
# LIMIT_OLLAMA_CPUS=1.0
# LIMIT_OLLAMA_MEMORY=2g
# LIMIT_BACKEND_CPUS=1.0
# LIMIT_BACKEND_MEMORY=1g
# LIMIT_FRONTEND_CPUS=0.5
# LIMIT_FRONTEND_MEMORY=256m

# ── 개발용(compose.dev.yaml) 포트
DEV_BACKEND_PORT=19522
DEV_DB_PORT=13306
